FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN groupadd --gid 10001 mltrain && useradd --uid 10001 --gid mltrain --create-home mltrain
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .
COPY --chown=mltrain:mltrain configs ./configs
USER 10001:10001
ENTRYPOINT ["python", "-m", "ml_platform.training.train"]
